# Lucky Spins Casino App - Environment Configuration Template
# Copy this file to .env and fill in your values

# Required: Database connection (PostgreSQL)
# Example: postgresql://user:password@host:port/database
DATABASE_URL=

# Required: JWT secret for session signing
JWT_SECRET=change-me-in-production

# Required: OAuth App ID
VITE_APP_ID=lucky-spins-dev

# Required: OAuth server URL
OAUTH_SERVER_URL=http://localhost:3000

# Optional: Admin owner OpenID
OWNER_OPEN_ID=owner

# Optional: AI/Forge API services
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Optional: Square payment processing
# Sandbox vs production is AUTO-DETECTED from VITE_SQUARE_APP_ID
# (sandbox app IDs start with "sandbox-"/"sandboxx-"). Set explicitly to override:
SQUARE_ENVIRONMENT=
SQUARE_ACCESS_TOKEN=
# Must belong to the SAME Square account + environment as the access token.
SQUARE_LOCATION_ID=
VITE_SQUARE_APP_ID=

# Optional: Coinbase Commerce (crypto payments) — charges without this key are disabled
COINBASE_COMMERCE_API_KEY=

# Public base URL used for Square's post-payment redirect back to /checkout-success
APP_URL=http://localhost:3000

# Node environment
NODE_ENV=development
PORT=3000
